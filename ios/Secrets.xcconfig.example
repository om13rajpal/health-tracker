// Copy to Secrets.xcconfig (gitignored) and fill in, then set it as the
// configuration file for the HealthBridge target in Xcode:
//   Project → HealthBridge → Info → Configurations → Debug/Release.
//
// Info.plist reads these through $(API_BASE_URL) and $(MCP_ACCESS_TOKEN),
// so the real token never reaches source control.

// No trailing slash.
API_BASE_URL = https:/$()/health-tracker-api.onrender.com

// Must match the API's MCP_ACCESS_TOKEN exactly.
MCP_ACCESS_TOKEN = replace-with-the-shared-secret
